# =====================================================================
# Configuration de l'application mobile « Sécurité RDC »
#
# Copiez ce fichier vers `.env` puis adaptez-le :
#     copy .env.example .env
#
# ATTENTION : ce fichier est embarqué dans le binaire (asset Flutter).
# N'y placez AUCUN secret (clé API, mot de passe, token JWT).
# =====================================================================

# Adresse du backend Flask (sans slash final)
#   - appareil réel     : IP LAN de la machine qui lance `run.py`
#   - émulateur Android  : http://10.0.2.2:1200
#   - simulateur iOS     : http://127.0.0.1:1200
API_BASE_URL=http://192.168.1.237:1200/api/v1

# Même hôte SANS le préfixe /api/v1 (Socket.IO)
SOCKET_URL=http://192.168.1.237:1200

# Moteur de carte : `osm` (OpenStreetMap, gratuit, sans clé) ou `google`
# Pour `google`, il faut une clé Google Cloud + compte de facturation,
# puis ajouter le package google_maps_flutter et la clé dans AndroidManifest.
MAP_PROVIDER=osm
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT=securite_rdc/1.0

# Identité visuelle
APP_NOM=Sécurité RDC
APP_SLOGAN=Protéger, alerter, intervenir

# Comportement
# Affiche les journaux Dio (true en développement uniquement)
DEBUG_RESEAU=true
# Nombre d'éléments par page dans les listes paginées
PAR_PAGE=20

# Plafond des images (bytes) — 200 Ko
IMAGE_MAX_OCTETS=204800
