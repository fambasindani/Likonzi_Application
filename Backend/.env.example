# =====================================================================
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
#   cp .env.example .env
# =====================================================================

FLASK_ENV=development

# Sécurité — OBLIGATOIRE en production : clés distinctes et aléatoires
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacez-par-une-cle-secrete-longue
JWT_SECRET_KEY=remplacez-par-une-autre-cle-secrete-longue
JWT_ALGORITHM=HS256
JWT_ISSUER=securite-sociale-v2
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Base de données MySQL 8
DB_DRIVER=pymysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=securite_sociale_v2
DB_CHARSET=utf8mb4
SQL_ECHO=false

# Réseau
# Adresse IP LAN de cette machine : 192.168.1.237
HOST=0.0.0.0
PORT=1200
CORS_ORIGINS=*
SOCKETIO_CORS_ORIGINS=*

# Limitation de débit (fenêtre glissante en mémoire, par IP + identifiant)
RATE_LIMIT_ENABLED=true
LOGIN_MAX=10
LOGIN_WINDOW_SEC=300
INSCRIPTION_MAX=10
INSCRIPTION_WINDOW_SEC=3600
RESET_MAX=5
RESET_WINDOW_SEC=300
VERIFICATION_MAX=10
VERIFICATION_WINDOW_SEC=300

# Comptes
BCRYPT_LOG_ROUNDS=12
PASSWORD_MIN_LENGTH=8
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
ADMIN_EMAIL=admin@securite.cd

# Fichiers
MAX_CONTENT_LENGTH=15728640
# Plafond des images (bytes) — 200 Ko par défaut
IMAGE_MAX_OCTETS=204800

# E-mails — passez à true en production et renseignez le SMTP
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@securite.cd
